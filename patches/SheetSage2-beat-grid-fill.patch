+def _repair_beat_gaps(beats, path):
+    """Fill beat rows dropped by the beat tracker inside a measure.
+
+    On real-world music the decoded beat grid occasionally misses a row (for
+    example IDs [1, 3, 4] inside one measure), which made the whole ABC rebuild
+    abort.  Missing rows are re-created with linearly interpolated times and
+    the following row's meter, keeping the grid self-consistent for measure
+    inference, subbeat alignment and serialization.  A dropped downbeat row is
+    repaired the same way by re-creating beats 1..(next-1) before it.
+    """
+    if len(beats) < 2:
+        return beats
+    repaired = [beats[0]]
+    filled = 0
+    for previous, following in zip(beats, beats[1:]):
+        if following.beat_id > 1 and previous.beat_id >= following.beat_id:
+            span = following.time - previous.time
+            for offset in range(1, following.beat_id):
+                repaired.append(BeatEvent(
+                    time=previous.time + span * offset / following.beat_id,
+                    beat_id=offset,
+                    declared_numerator=following.declared_numerator,
+                    denominator=following.denominator,
+                    line_no=previous.line_no,
+                ))
+                filled += 1
+        else:
+            gap = following.beat_id - previous.beat_id
+            if gap > 1:
+                span = following.time - previous.time
+                for offset in range(1, gap):
+                    repaired.append(BeatEvent(
+                        time=previous.time + span * offset / gap,
+                        beat_id=previous.beat_id + offset,
+                        declared_numerator=following.declared_numerator,
+                        denominator=following.denominator,
+                        line_no=previous.line_no,
+                    ))
+                    filled += 1
+        repaired.append(following)
+    if filled:
+        print(f"SheetSage2: filled {filled} missing beat row(s) in the decoded beat grid ({path})",
+              file=sys.stderr)
+    return repaired
 
 
